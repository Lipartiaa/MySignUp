
<style>
    /* Container for the form */
    form {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        padding: 20px;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    /* Form title */
    h1 {
        text-align: center;
        color: #333;
        font-size: 24px;
        margin-bottom: 20px;
    }

    /* Style for form fields */
    div {
        margin-bottom: 15px;
    }

    /* Style for labels */
    label {
        display: block;
        font-weight: bold;
        margin-bottom: 5px;
        color: #555;
    }

    /* Style for input fields */
    input[type="text"],
    input[type="date"] {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-sizing: border-box;
        background-color: #fff;
        color: #333;
        transition: border-color 0.3s ease;
    }

    /* Focus state for input fields */
    input[type="text"]:focus,
    input[type="date"]:focus {
        border-color: #ffa500;
        outline: none;
    }

    /* Submit button */
    button[type="submit"] {
        width: 100%;
        padding: 12px;
        background-color: #ffa500;
        color: #fff;
        font-size: 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    /* Hover effect for button */
    button[type="submit"]:hover {
        background-color: #ff8c00;
    }

    /* Input field error state */
    input:invalid {
        border-color: #e74c3c;
    }

    /* Responsive Design */
    @media (max-width: 600px) {
        form {
            padding: 15px;
        }

        h1 {
            font-size: 20px;
        }

        button[type="submit"] {
            font-size: 14px;
        }
    }
</style>

<h1>Sign Up</h1>
<form action="<?= $block->getUrl('mysignup/index/post') ?>" method="POST">
    <input type="hidden" name="form_key" value="<?= $block->getFormKey(); ?>"/>

    <div>
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" required/>
    </div>

    <div>
        <label for="date">Date:</label>
        <input type="date" id="date" name="date" required/>
    </div>

    <div>
        <button type="submit">Submit</button>
    </div>
</form>
